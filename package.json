{
  "name": "tokengame",
  "version": "0.1.0",
  "private": true,
  "description": "Local TokenGame prototype with an authoritative four-seat Hold'em table and Codex public-AI bridge.",
  "scripts": {
    "table": "node src/run-probe.cjs",
    "probe": "node src/run-probe.cjs",
    "authority": "node src/authority/server.cjs",
    "core": "node src/run-table-core.cjs",
    "web": "node src/run-table-web.cjs",
    "bridge": "node src/bridge/server.cjs",
    "codex:configure": "node plugins/tokengame/codex/configure-project.cjs",
    "codex:play": "node plugins/tokengame/codex/play.cjs",
    "codex:connect": "node plugins/tokengame/codex/connect.cjs",
    "connection:activate": "node src/run-model-connection.cjs activate",
    "connection:clear": "node src/run-model-connection.cjs clear",
    "acceptance:refill": "node test-support/test-chip-refill-browser-acceptance.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.cjs",
    "gate": "node test-support/gate.cjs",
    "beta": "node src/run-beta.cjs",
    "beta:remote": "node src/run-remote-beta.cjs"
  },
  "engines": {
    "node": ">=22"
  }
}
