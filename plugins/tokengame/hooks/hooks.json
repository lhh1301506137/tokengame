{
  "description": "TokenGame local public-turn bridge probe",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/user_prompt_submit.cjs\"",
            "commandWindows": "node -e \"require(process.env.PLUGIN_ROOT + '/hooks/user_prompt_submit.cjs')\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/stop.cjs\"",
            "commandWindows": "node -e \"require(process.env.PLUGIN_ROOT + '/hooks/stop.cjs')\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/pre_tool_use.cjs\"",
            "commandWindows": "node -e \"require(process.env.PLUGIN_ROOT + '/hooks/pre_tool_use.cjs')\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
