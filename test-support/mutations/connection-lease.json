    },
    {
      "id": "release-keeps-custody-binding",
      "file": "src/host/table-web-host.cjs",
      "needle": "      this.sessions.delete(session.token);\n      this.custody.forget(session.seat_handle);",
      "replacement": "      this.sessions.delete(session.token);",
      "test": "test/connection-lease.test.cjs",
      "note": "另一半：会话删了但托管绑定留着，于是那份席位凭据继续躺在协调器内存里。两条分开列是因为它们能各自失效，而任一条失效时另一条都还是绿的。"
    },
    {
      "id": "release-probe-uses-public-seat-view",
      "file": "src/host/table-web-host.cjs",
      "needle": "        await this.core.dispatch(\"view.hand\", this.injected(\"view.hand\", session, {}));",
